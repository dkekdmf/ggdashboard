  {
    "id": "make_color",
    "type": "function",
    "z": "flow_led",
    "name": "색 이름 담기",
    "func": "// 서버는 {\"color\":\"RED\"} 모양을 받는다.\n// 버튼이 보낸 글자(RED/GREEN/BLUE/OFF)를 그대로 담아 준다.\nconst name = String(msg.payload || '').toUpperCase();\n\nmsg.payload = { color: name };\nmsg.headers = { 'Content-Type': 'application/json' };\n\nnode.status({ fill: 'blue', shape: 'dot', text: name });\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 395,
    "wires": [
