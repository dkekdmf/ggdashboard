  {
    "id": "show_result",
    "type": "function",
    "z": "flow_led",
    "name": "결과 만들기",
    "func": "// 서버가 돌려주는 sent 로 아두이노까지 전달됐는지 알 수 있다.\n//   sent:true  → 아두이노로 명령이 나갔다\n//   sent:false → 아두이노가 연결되지 않아 못 보냈다\nconst ok = msg.payload && msg.payload.sent;\nconst color = (msg.payload && msg.payload.color) || '';\n\nnode.status(ok\n    ? { fill: 'green', shape: 'dot', text: '전달됨 ' + color }\n    : { fill: 'red', shape: 'ring', text: '아두이노 미연결' });\n\nmsg.payload = ok\n    ? '✅ 켰어요 — ' + color\n    : '⚠️ 아두이노가 연결되지 않았어요';\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 830,
    "y": 465,
    "wires": [
      [
        "status_text"
      ]
    ]
