  {
    "id": "split_dht",
    "type": "function",
    "z": "flow_led",
    "name": "온도·습도 나누기",
    "func": "// 서버가 이미 숫자로 정리해서 준다\n//   {\"temperature\":23.4, \"humidity\":52.0, \"received\":true}\n//\n// received 가 false 면 아직 센서 값이 한 번도 안 온 것이다.\n// 그때는 계기판을 건드리지 않는다(0 으로 뚝 떨어지면 오해하기 쉽다).\nconst d = msg.payload;\n\nif (!d || d.received !== true) {\n    node.status({ fill: 'grey', shape: 'ring', text: '센서 값 기다리는 중' });\n    return null;\n}\n\nnode.status({ fill: 'green', shape: 'dot', text: d.temperature + '°C / ' + d.humidity + '%' });\n\n// 출력이 두 개다. 첫 번째는 온도, 두 번째는 습도로 보낸다.\nreturn [\n    { payload: d.temperature },\n    { payload: d.humidity }\n];",
    "outputs": 2,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
    "y": 120,
    "wires": [
      [
        "temp_gauge"
      ],
      [
        "hum_gauge"
      ]
    ]
  },
