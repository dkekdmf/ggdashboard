  {
    "id": "make_rgb",
    "type": "function",
    "z": "flow_led",
    "name": "숫자 세 개로 바꾸기",
    "func": "// 색 고르기 위젯은 format=hex, outformat=string 으로 두어 \"#ff8000\" 처럼 보낸다.\n// 다만 설정이 바뀌어도 동작하도록 세 가지 모양을 모두 받아 준다.\n//   { r:255, g:128, b:0 }  또는  \"#ff8000\"  또는  \"rgb(255,128,0)\"\n// 어느 쪽이 와도 {r,g,b} 로 맞춰 준다.\nconst clamp = v => Math.max(0, Math.min(255, Math.round(Number(v) || 0)));\nlet r = 0, g = 0, b = 0;\n\nconst p = msg.payload;\n\nif (p && typeof p === 'object' && p.r !== undefined) {\n    r = p.r; g = p.g; b = p.b;\n\n} else if (typeof p === 'string') {\n    const hex = p.match(/^#?([0-9a-f]{6})$/i);\n    const rgb = p.match(/rgba?\\(([^)]+)\\)/i);\n\n    if (hex) {\n        const n = parseInt(hex[1], 16);\n        r = (n >> 16) & 255; g = (n >> 8) & 255; b = n & 255;\n    } else if (rgb) {\n        const parts = rgb[1].split(',');\n        r = parts[0]; g = parts[1]; b = parts[2];\n    }\n}\n\nmsg.payload = { r: clamp(r), g: clamp(g), b: clamp(b) };\nmsg.headers = { 'Content-Type': 'application/json' };\n\nnode.status({ fill: 'blue', shape: 'dot', text: `${msg.payload.r},${msg.payload.g},${msg.payload.b}` });\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 540,
    "wires": [
      [
        "post_rgb"
      ]
    ]
  },
