  {
    "id": "button_text",
    "type": "function",
    "z": "flow_led",
    "name": "눌림 여부 글로",
    "func": "// 서버는 택트스위치가 눌렸는지를 함께 알려 준다.\n//   {\"buttonPressed\":true, \"state\":\"GO\", \"time\":240}\n//\n// 짧게 톡 누르면 0.5초마다 묻는 사이에 지나가 버리므로,\n// 서버가 0.6초 동안 눌림을 붙잡아 두었다가 알려 준다.\nconst d = msg.payload || {};\n\nmsg.payload = d.buttonPressed\n    ? '🟢 눌렸어요!'\n    : '⚪ 안 눌림';\n\nnode.status({\n    fill: d.buttonPressed ? 'green' : 'grey',\n    shape: 'dot',\n    text: d.buttonPressed ? '눌림' : '대기'\n});\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 210,
    "wires": [
      [
        "button_status"
      ]
    ]
  },
